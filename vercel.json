{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo \"Sin build: solo se sirve api/mcp.mjs\"",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "mcp/data.json",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    }
  ]
}
