{
  "name": "robur-ds",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tokens": "node scripts/build-tokens.mjs",
    "check": "node scripts/build-tokens.mjs && node scripts/check-contrast.mjs && node scripts/check-contracts.mjs && node scripts/check-figma.mjs",
    "build": "npm run tokens && vue-tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "npm run tokens && storybook dev -p 6007",
    "build-storybook": "npm run tokens && storybook build",
    "test": "npm run check && vitest run"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "^1.90.0",
    "playwright": "latest",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "latest",
    "vue-component-meta": "^3.3.14",
    "vue-tsc": "^3.3.14"
  }
}
